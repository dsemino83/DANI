# Copiar a .env (no se sube al repositorio) y completar.

# Ambiente de la credencial API Banking que usa este despliegue: homo | prod
BDV_AMBIENTE=homo

# SSO de VALO (OIDC). Homologación:
OIDC_ISSUER=https://ssohomo.valo.ar/valo/realms/staff
# Desarrollo local con el Keycloak del perfil "dev":
# OIDC_ISSUER=http://localhost:8081/realms/staff
# OIDC_INTERNAL_URL=http://keycloak:8080/realms/staff

OIDC_AUDIENCE=home-banking-api
OIDC_ROLES_CLIENT=home-banking-api
KEYCLOAK_ADMIN_CLIENT_ID=home-banking-admin

BDV_SESION_MINUTOS=20
HTTPS_PORT=443
