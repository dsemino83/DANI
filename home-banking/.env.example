# Copiar a .env (no se sube al repositorio) y completar.

# Ambiente de la credencial API Banking que usa este despliegue: homo | prod
BDV_AMBIENTE=homo
# Modo solo consultas: saldos, movimientos, débitos y CBU reales, pero ninguna aprobación
# envía transferencias al banco. Recomendado para la primera prueba con producción.
BDV_SOLO_CONSULTAS=false
# Meses completos que quedan en la base operativa además del mes en curso (lo anterior pasa a la histórica el día 1)
HB_RETENCION_MESES=1
# La URL del banco la define el ambiente (no se carga a mano):
#   homo -> https://apihomo.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking
#   prod -> https://api.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking
# Opcional, solo homologación: apuntar a un simulador del banco.
# BDV_URL_HOMO=http://simulador:8080/bdv

# ---- Identidad: elegir UNA de las dos opciones ----
# A) Todo en Docker: Keycloak propio (perfil sso-local), publicado en <HB_URL_PUBLICA>/auth.
#    Levantar con: docker compose --profile sso-local up -d
#    HB_URL_PUBLICA es la dirección con la que entran los usuarios (https://localhost en una PC,
#    https://<nombre o IP del servidor> en un servidor).
HB_URL_PUBLICA=https://localhost
OIDC_ISSUER=https://localhost/auth/realms/staff
OIDC_INTERNAL_URL=http://keycloak:8080/auth/realms/staff
OIDC_ORIGIN=https://localhost
# B) SSO de VALO (Identidad crea los clientes; ver DESPLIEGUE.md). Homologación:
# OIDC_ISSUER=https://ssohomo.valo.ar/valo/realms/staff
# OIDC_ORIGIN=https://ssohomo.valo.ar
# (sin OIDC_INTERNAL_URL ni HB_URL_PUBLICA; levantar sin --profile sso-local)

OIDC_CLIENT_ID=home-banking-web
OIDC_AUDIENCE=home-banking-api
OIDC_ROLES_CLIENT=home-banking-api
KEYCLOAK_ADMIN_CLIENT_ID=home-banking-admin

BDV_SESION_MINUTOS=20
# Circuit breaker BDV: abre tras fallas consecutivas de disponibilidad y prueba recuperación solo con consultas.
BDV_CIRCUIT_BREAKER_ENABLED=true
BDV_CIRCUIT_BREAKER_FAILURES=5
BDV_CIRCUIT_BREAKER_RESET_MS=30000
HTTPS_PORT=443

# Imágenes publicadas (GitHub Actions → Docker Hub). Vacío = se compilan en la PC con --build.
# HB_IMAGEN=docker.io/<usuario-docker-hub>/home-banking-valo
# HB_VERSION=alyc

# La documentación (auditoría, técnica y manual) viaja dentro de la aplicación: no hace falta configurar nada.

# Correo saliente: Keycloak (avisos de cambio de clave) y backend (envíos programados a las empresas). Vacío = buzón de prueba Mailpit
# (perfil correo-prueba, http://localhost:8025). Aplicar con: sh scripts/configurar-correo.sh
# La clave del servidor de correo va en secrets/smtp_password.txt.
# HB_SMTP_HOST=smtp.office365.com
# HB_SMTP_PORT=587
# HB_SMTP_FROM=alyc@valo.ar
# HB_SMTP_USUARIO=homebanking@valo.ar
# HB_SMTP_STARTTLS=true

# Alertas de movimientos por chat de Teams (Power Automate). Vacío = no se envían (solo el correo al cliente).
# La URL del flujo lleva una firma y es secreta: idealmente por HB_POWERAUTOMATE_URL_FILE (secreto de Docker).
# Ver powerautomate/ALERTAS-TEAMS.md.
# HB_POWERAUTOMATE_URL=https://prod-00.westus.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?...&sig=...
# HB_CHAT_DOMINIO=@valo.ar

# Salida de correo de RESPALDO (opcional): si el servidor principal falla, el correo se reintenta por acá.
# Tiene que ser una salida aprobada por VALO: estos correos llevan movimientos de cuentas de clientes.
# La clave va en el Docker secret secrets/smtp2_password.txt (HB_SMTP2_PASSWORD_FILE ya apunta ahí); no en este .env.
# HB_SMTP2_HOST=relay2.valo.ar
# HB_SMTP2_PORT=587
# HB_SMTP2_FROM=alyc@valo.ar
# HB_SMTP2_USUARIO=

# Observabilidad (opcional): métricas Prometheus en /api/metrics. Apagado por defecto.
# Encender: METRICS_ENABLED=true y el MISMO token acá y en secrets/metrics_token.txt (lo usa Prometheus).
# Nginx no expone /api/metrics al público; Prometheus lo consulta directo por la red interna. Ver ops/README-OBSERVABILIDAD.md.
# METRICS_ENABLED=false
# METRICS_TOKEN=
# GRAFANA_ADMIN_USER=admin
# HB_GRAFANA_PUERTO=3001

# Monitoreo sintético: solo disponibilidad/sesión BDV, sin saldos, movimientos ni transferencias.
SYNTHETIC_MONITOR_ENABLED=false
SYNTHETIC_MONITOR_CRON=*/5 * * * *
SYNTHETIC_REQUIRE_READ_ONLY=true

# OpenTelemetry (trazas distribuidas): APAGADO por defecto. Enviar trazas a un OTEL Collector.
# La observabilidad nunca bloquea: si el collector está caído, el backend sigue. Ver docs/OBSERVABILIDAD-OPENTELEMETRY.md.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=home-banking-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.10
# OTEL_METRIC_EXPORT_INTERVAL_MS=15000

# Consultas al banco: cuentas distintas en paralelo (solo lectura, p. ej. débitos de varias cuentas). 1 = secuencial.
# BDV_CONCURRENCIA=3

# --- SQL Server 2025 (base de datos) ---
# ACCEPT_EULA=Y acepta los términos de uso de Microsoft SQL Server (obligatorio para que la instancia arranque).
ACCEPT_EULA=Y
# Edición: Developer (pruebas, sin costo, no apta para producción), Standard, Enterprise, o la clave de producto de la licencia de VALO.
MSSQL_PID=Developer
# Memoria máxima de la instancia en MB (el contenedor tiene un tope de 4 GB). SQL Server pide al menos 2 GB.
MSSQL_MEMORY_LIMIT_MB=3072
# true: la app confía en el certificado propio de la instancia (el tráfico va cifrado por la red interna "datos").
# false: exige un certificado firmado por una CA que el contenedor del backend conozca.
DB_TRUST_SERVER_CERT=true
