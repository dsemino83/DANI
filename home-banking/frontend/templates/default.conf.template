# Nginx: sirve la SPA y hace de proxy a /api. El navegador nunca habla con el banco.
# Plantilla procesada por envsubst al arrancar (imagen oficial de nginx): ${OIDC_ORIGIN}.

# Primera barrera contra abuso: pedidos a la API por IP (el backend además limita por usuario)
limit_req_zone $binary_remote_addr zone=hb_api:10m rate=30r/s;
limit_req_status 429;
server_tokens off;

server {
  listen 443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_tickets off;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header Referrer-Policy no-referrer always;
  # Solo scripts propios; el navegador solo puede hablar con la app y con el SSO de VALO
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${OIDC_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self' ${OIDC_ORIGIN}" always;

  client_max_body_size 10m;   # carga masiva

  # Métricas de observabilidad: NO se exponen al público. Prometheus las consulta directo al backend por la
  # red interna (backend:8080/api/metrics), nunca por acá. Debe ir antes de "location /api/".
  location = /api/metrics { return 404; }

  location /api/ {
    limit_req zone=hb_api burst=60 nodelay;
    # Se resuelve en cada pedido (como /auth/): si se recrea el backend cambia su IP, y con un
    # proxy_pass estatico Nginx la cachearia y responderia 502 hasta reiniciar el frontend.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hb_backend http://backend:8080;
    proxy_pass $hb_backend;
    proxy_set_header X-Request-Id $request_id;   # el mismo id en los logs de Nginx y del backend
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # se SOBRESCRIBE: el cliente no puede falsear su IP (auditoría, límites, Keycloak)
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 300s;  # aprobación de lotes y exportaciones largas
  }

  # Keycloak propio (perfil sso-local): mismo origen que la app. Se resuelve en cada pedido, así Nginx
  # arranca aunque Keycloak no esté (cuando se usa el SSO de VALO). Sin la CSP de la app: Keycloak trae la suya.
  location /auth/ {
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $hb_keycloak http://keycloak:8080;
    proxy_pass $hb_keycloak;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;   # se SOBRESCRIBE: el cliente no puede falsear su IP (auditoría, límites, Keycloak)
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_buffer_size 128k;     # cabeceras grandes de Keycloak (cookies y tokens)
    proxy_buffers 4 256k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
  }

  location = /config.json {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store" always;
  }

  location / {
    root /usr/share/nginx/html;
    try_files $uri /index.html;
    # El navegador revalida cada archivo (ETag → 304 si no cambió): después de actualizar se ve la versión
    # nueva sin borrar la caché. "expires" (no add_header) para no perder los encabezados de seguridad.
    expires epoch;
    etag on;
  }
}
