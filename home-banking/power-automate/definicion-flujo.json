{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "ambiente": {
              "title": "Ambiente",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "homo o prod",
              "x-ms-content-hint": "TEXT"
            },
            "login": {
              "title": "Usuario API (login)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Usuario de la API Banking",
              "x-ms-content-hint": "TEXT"
            },
            "password": {
              "title": "Clave cifrada",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Clave ya cifrada con la llave pública RSA del banco (base64)",
              "x-ms-content-hint": "TEXT"
            },
            "terminal": {
              "title": "Terminal",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Nombre del servidor que ejecuta las APIs",
              "x-ms-content-hint": "TEXT"
            },
            "identification": {
              "title": "DNI (identification)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "DNI del usuario API",
              "x-ms-content-hint": "TEXT"
            },
            "cuenta": {
              "title": "Cuenta para movimientos (opcional)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Número de cuenta propia; vacío = no consulta movimientos",
              "x-ms-content-hint": "TEXT"
            }
          },
          "required": [
            "ambiente",
            "login",
            "password",
            "terminal",
            "identification"
          ]
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    }
  },
  "actions": {
    "URL_base": {
      "type": "Compose",
      "runAfter": {},
      "inputs": "@if(equals(toLower(trim(triggerBody()?['ambiente'])), 'prod'), 'https://api.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking', 'https://apihomo.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking')"
    },
    "Ambiente_valido": {
      "type": "If",
      "runAfter": {
        "URL_base": [
          "Succeeded"
        ]
      },
      "expression": {
        "or": [
          {
            "equals": [
              "@toLower(trim(triggerBody()?['ambiente']))",
              "prod"
            ]
          },
          {
            "equals": [
              "@toLower(trim(triggerBody()?['ambiente']))",
              "homo"
            ]
          }
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Ambiente_invalido": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "AMBIENTE",
                "message": "El ambiente tiene que ser homo o prod"
              }
            }
          }
        }
      }
    },
    "Login": {
      "type": "Http",
      "runAfter": {
        "Ambiente_valido": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/security/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "login": "@{triggerBody()?['login']}",
          "password": "@{triggerBody()?['password']}",
          "terminal": "@{triggerBody()?['terminal']}",
          "channel": "3",
          "identification": "@{triggerBody()?['identification']}"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    },
    "Login_OK": {
      "type": "If",
      "runAfter": {
        "Login": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@body('Login')?['success']",
              true
            ]
          }
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Login_rechazado": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "LOGIN",
                "message": "@{concat('El banco rechazó el login: ', string(body('Login')?['message']?['code']), ' ', string(body('Login')?['message']?['message']))}"
              }
            }
          }
        }
      }
    },
    "Cookie_de_sesion": {
      "type": "Compose",
      "runAfter": {
        "Login_OK": [
          "Succeeded"
        ]
      },
      "inputs": "@first(split(string(outputs('Login')?['headers']?['Set-Cookie']), ';'))",
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    },
    "getUserEntityInformation": {
      "type": "Http",
      "runAfter": {
        "Cookie_de_sesion": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/enrollment/getUserEntityInformation",
        "headers": {
          "Content-Type": "application/json",
          "Cookie": "@{outputs('Cookie_de_sesion')}"
        },
        "body": {}
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "getOwnAccounts": {
      "type": "Http",
      "runAfter": {
        "getUserEntityInformation": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/accounts/getOwnAccounts",
        "headers": {
          "Content-Type": "application/json",
          "Cookie": "@{outputs('Cookie_de_sesion')}"
        },
        "body": {}
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "Cuentas": {
      "type": "Select",
      "runAfter": {
        "getOwnAccounts": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@coalesce(body('getOwnAccounts')?['accountsArray'], json('[]'))",
        "select": {
          "Cuenta": "@concat(take(string(item()?['productNumber']), 3), '•••', substring(string(item()?['productNumber']), sub(length(string(item()?['productNumber'])), 3), 3))",
          "Producto": "@item()?['productName']",
          "Alias": "@item()?['productAlias']",
          "Moneda": "@if(equals(int(item()?['currencyId']), 80), 'ARS', 'USD')",
          "Disponible": "@item()?['availableBalance']",
          "Contable": "@item()?['accountingBalance']"
        }
      }
    },
    "Tabla_de_cuentas": {
      "type": "Table",
      "runAfter": {
        "Cuentas": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@body('Cuentas')",
        "format": "HTML"
      }
    },
    "Pidio_movimientos": {
      "type": "If",
      "runAfter": {
        "Tabla_de_cuentas": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@trim(coalesce(triggerBody()?['cuenta'], ''))",
                ""
              ]
            }
          }
        ]
      },
      "actions": {
        "Cuenta_elegida": {
          "type": "Query",
          "runAfter": {},
          "inputs": {
            "from": "@coalesce(body('getOwnAccounts')?['accountsArray'], json('[]'))",
            "where": "@equals(string(item()?['productNumber']), trim(triggerBody()?['cuenta']))"
          }
        },
        "Cuenta_encontrada": {
          "type": "If",
          "runAfter": {
            "Cuenta_elegida": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "greater": [
                  "@length(body('Cuenta_elegida'))",
                  0
                ]
              }
            ]
          },
          "actions": {
            "getMovementsDetail": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "@{outputs('URL_base')}/accounts/getMovementsDetail",
                "headers": {
                  "Content-Type": "application/json",
                  "Cookie": "@{outputs('Cookie_de_sesion')}"
                },
                "body": {
                  "productId": "@first(body('Cuenta_elegida'))?['productId']",
                  "currencyId": "@first(body('Cuenta_elegida'))?['currencyId']",
                  "productNumber": "@first(body('Cuenta_elegida'))?['productNumber']",
                  "numberOfMovements": 900,
                  "sequential": "0",
                  "uniqueSequential": "0",
                  "initialDate": "@{formatDateTime(convertFromUtc(utcNow(), 'Argentina Standard Time'), 'MM/dd/yyyy')}",
                  "finalDate": "@{formatDateTime(convertFromUtc(utcNow(), 'Argentina Standard Time'), 'MM/dd/yyyy')}",
                  "mode": "0",
                  "serviceId": "3"
                }
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              }
            },
            "Movimientos": {
              "type": "Select",
              "runAfter": {
                "getMovementsDetail": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('getMovementsDetail')?['accountStatementArray'], json('[]'))",
                "select": {
                  "Fecha": "@item()?['processDate']",
                  "Hora": "@item()?['hour']",
                  "DC": "@item()?['signDC']",
                  "Importe": "@item()?['amount']",
                  "Descripcion": "@item()?['description']",
                  "Saldo": "@item()?['availableBalance']"
                }
              }
            },
            "Tabla_de_movimientos": {
              "type": "Table",
              "runAfter": {
                "Movimientos": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Movimientos')",
                "format": "HTML"
              }
            }
          },
          "else": {
            "actions": {
              "Cuenta_no_encontrada": {
                "type": "Compose",
                "runAfter": {},
                "inputs": "La cuenta indicada no está entre las cuentas propias"
              }
            }
          }
        }
      },
      "else": {
        "actions": {}
      }
    },
    "Resumen": {
      "type": "Compose",
      "runAfter": {
        "Pidio_movimientos": [
          "Succeeded"
        ]
      },
      "inputs": {
        "ambiente": "@toLower(trim(triggerBody()?['ambiente']))",
        "url": "@outputs('URL_base')",
        "entidad": "@body('getUserEntityInformation')?['completeName']",
        "cuentas": "@length(body('Cuentas'))",
        "nota": "Solo lectura: el flujo no llama a ninguna API de transferencia."
      }
    }
  },
  "outputs": {}
}