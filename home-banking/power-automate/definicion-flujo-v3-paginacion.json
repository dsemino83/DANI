{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "ambiente": {
              "title": "Ambiente",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "homo o prod",
              "x-ms-content-hint": "TEXT"
            },
            "login": {
              "title": "Usuario API (login)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Usuario de la API Banking",
              "x-ms-content-hint": "TEXT"
            },
            "password": {
              "title": "Clave cifrada",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Clave ya cifrada con la llave pública RSA del banco (base64)",
              "x-ms-content-hint": "TEXT"
            },
            "terminal": {
              "title": "Terminal",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Nombre del servidor que ejecuta las APIs",
              "x-ms-content-hint": "TEXT"
            },
            "identification": {
              "title": "DNI (identification)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "DNI del usuario API",
              "x-ms-content-hint": "TEXT"
            },
            "cuenta": {
              "title": "Cuenta",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Número completo de una cuenta propia",
              "x-ms-content-hint": "TEXT"
            },
            "desde": {
              "title": "Desde (AAAA-MM-DD)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Primer día del período",
              "x-ms-content-hint": "TEXT"
            },
            "hasta": {
              "title": "Hasta (AAAA-MM-DD)",
              "type": "string",
              "x-ms-dynamically-added": true,
              "description": "Último día del período",
              "x-ms-content-hint": "TEXT"
            }
          },
          "required": [
            "ambiente",
            "login",
            "password",
            "terminal",
            "identification",
            "cuenta",
            "desde",
            "hasta"
          ]
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    }
  },
  "actions": {
    "Var_modo": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "modo",
            "type": "string",
            "value": "0"
          }
        ]
      }
    },
    "Var_seq": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_modo": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "seq",
            "type": "string",
            "value": "0"
          }
        ]
      }
    },
    "Var_useq": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_seq": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "useq",
            "type": "string",
            "value": "0"
          }
        ]
      }
    },
    "Var_pagina": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_useq": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "pagina",
            "type": "integer",
            "value": 0
          }
        ]
      }
    },
    "Var_fin": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_pagina": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "fin",
            "type": "boolean",
            "value": false
          }
        ]
      }
    },
    "Var_acumulado": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_fin": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "acumulado",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "Var_paginas": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_acumulado": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "paginas",
            "type": "array",
            "value": []
          }
        ]
      }
    },
    "Var_error": {
      "type": "InitializeVariable",
      "runAfter": {
        "Var_paginas": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "error",
            "type": "string",
            "value": ""
          }
        ]
      }
    },
    "URL_base": {
      "type": "Compose",
      "runAfter": {
        "Var_error": [
          "Succeeded"
        ]
      },
      "inputs": "@if(equals(toLower(trim(triggerBody()?['ambiente'])), 'prod'), 'https://api.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking', 'https://apihomo.bancodevalores.com/CTSProxy/services/resources/channels/mobilebanking')"
    },
    "Entradas_validas": {
      "type": "If",
      "runAfter": {
        "URL_base": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "or": [
              {
                "equals": [
                  "@toLower(trim(triggerBody()?['ambiente']))",
                  "prod"
                ]
              },
              {
                "equals": [
                  "@toLower(trim(triggerBody()?['ambiente']))",
                  "homo"
                ]
              }
            ]
          },
          {
            "lessOrEquals": [
              "@ticks(triggerBody()?['desde'])",
              "@ticks(triggerBody()?['hasta'])"
            ]
          }
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Entradas_invalidas": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ENTRADAS",
                "message": "Ambiente homo o prod, y fechas AAAA-MM-DD con desde <= hasta"
              }
            }
          }
        }
      }
    },
    "Login": {
      "type": "Http",
      "runAfter": {
        "Entradas_validas": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/security/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "login": "@{triggerBody()?['login']}",
          "password": "@{triggerBody()?['password']}",
          "terminal": "@{triggerBody()?['terminal']}",
          "channel": "3",
          "identification": "@{triggerBody()?['identification']}"
        }
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    },
    "Login_OK": {
      "type": "If",
      "runAfter": {
        "Login": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@body('Login')?['success']",
              true
            ]
          }
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Login_rechazado": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "LOGIN",
                "message": "@{concat('El banco rechazó el login: ', string(body('Login')?['message']?['code']), ' ', string(body('Login')?['message']?['message']))}"
              }
            }
          }
        }
      }
    },
    "Cookie_de_sesion": {
      "type": "Compose",
      "runAfter": {
        "Login_OK": [
          "Succeeded"
        ]
      },
      "inputs": "@first(split(string(outputs('Login')?['headers']?['Set-Cookie']), ';'))",
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs",
            "outputs"
          ]
        }
      }
    },
    "getUserEntityInformation": {
      "type": "Http",
      "runAfter": {
        "Cookie_de_sesion": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/enrollment/getUserEntityInformation",
        "headers": {
          "Content-Type": "application/json",
          "Cookie": "@{outputs('Cookie_de_sesion')}"
        },
        "body": {}
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "getOwnAccounts": {
      "type": "Http",
      "runAfter": {
        "getUserEntityInformation": [
          "Succeeded"
        ]
      },
      "inputs": {
        "method": "POST",
        "uri": "@{outputs('URL_base')}/accounts/getOwnAccounts",
        "headers": {
          "Content-Type": "application/json",
          "Cookie": "@{outputs('Cookie_de_sesion')}"
        },
        "body": {}
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "inputs"
          ]
        }
      }
    },
    "Cuenta_elegida": {
      "type": "Query",
      "runAfter": {
        "getOwnAccounts": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@coalesce(body('getOwnAccounts')?['accountsArray'], json('[]'))",
        "where": "@equals(string(item()?['productNumber']), trim(triggerBody()?['cuenta']))"
      }
    },
    "Cuenta_encontrada": {
      "type": "If",
      "runAfter": {
        "Cuenta_elegida": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "greater": [
              "@length(body('Cuenta_elegida'))",
              0
            ]
          }
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Cuenta_inexistente": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "CUENTA",
                "message": "La cuenta indicada no está entre las cuentas propias"
              }
            }
          }
        }
      }
    },
    "Paginar_movimientos": {
      "type": "Until",
      "runAfter": {
        "Cuenta_encontrada": [
          "Succeeded"
        ]
      },
      "expression": "@equals(variables('fin'), true)",
      "limit": {
        "count": 100,
        "timeout": "PT1H"
      },
      "actions": {
        "getMovementsDetail": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "POST",
            "uri": "@{outputs('URL_base')}/accounts/getMovementsDetail",
            "headers": {
              "Content-Type": "application/json",
              "Cookie": "@{outputs('Cookie_de_sesion')}"
            },
            "body": {
              "productId": "@first(body('Cuenta_elegida'))?['productId']",
              "currencyId": "@first(body('Cuenta_elegida'))?['currencyId']",
              "productNumber": "@first(body('Cuenta_elegida'))?['productNumber']",
              "numberOfMovements": 900,
              "sequential": "@{variables('seq')}",
              "uniqueSequential": "@{variables('useq')}",
              "initialDate": "@{formatDateTime(triggerBody()?['desde'], 'MM/dd/yyyy')}",
              "finalDate": "@{formatDateTime(triggerBody()?['hasta'], 'MM/dd/yyyy')}",
              "mode": "@{variables('modo')}",
              "serviceId": "3"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        },
        "Respuesta_OK": {
          "type": "If",
          "runAfter": {
            "getMovementsDetail": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@body('getMovementsDetail')?['success']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Filas_de_la_pagina": {
              "type": "Compose",
              "runAfter": {},
              "inputs": "@coalesce(body('getMovementsDetail')?['accountStatementArray'], json('[]'))"
            },
            "Contar_pagina": {
              "type": "IncrementVariable",
              "runAfter": {
                "Filas_de_la_pagina": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "pagina",
                "value": 1
              }
            },
            "Registrar_pagina": {
              "type": "AppendToArrayVariable",
              "runAfter": {
                "Contar_pagina": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "name": "paginas",
                "value": {
                  "Pagina": "@variables('pagina')",
                  "Mode": "@variables('modo')",
                  "Sequential_enviado": "@variables('seq')",
                  "Movimientos": "@length(outputs('Filas_de_la_pagina'))",
                  "Primer_sequential": "@first(outputs('Filas_de_la_pagina'))?['sequential']",
                  "Ultimo_sequential": "@last(outputs('Filas_de_la_pagina'))?['sequential']",
                  "Ultimo_uniqueSequential": "@last(outputs('Filas_de_la_pagina'))?['uniqueSequential']",
                  "Primer_movimiento": "@concat(first(outputs('Filas_de_la_pagina'))?['processDate'], ' ', first(outputs('Filas_de_la_pagina'))?['hour'])",
                  "Ultimo_movimiento": "@concat(last(outputs('Filas_de_la_pagina'))?['processDate'], ' ', last(outputs('Filas_de_la_pagina'))?['hour'])"
                }
              }
            },
            "Hay_filas": {
              "type": "If",
              "runAfter": {
                "Registrar_pagina": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(outputs('Filas_de_la_pagina'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Acumular_filas": {
                  "type": "AppendToStringVariable",
                  "runAfter": {},
                  "inputs": {
                    "name": "acumulado",
                    "value": "@concat(if(equals(variables('pagina'), 1), '', ','), substring(string(outputs('Filas_de_la_pagina')), 1, sub(length(string(outputs('Filas_de_la_pagina'))), 2)))"
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Hay_mas_paginas": {
              "type": "If",
              "runAfter": {
                "Hay_filas": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@length(outputs('Filas_de_la_pagina'))",
                      900
                    ]
                  }
                ]
              },
              "actions": {
                "Avanza": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "and": [
                      {
                        "not": {
                          "equals": [
                            "@string(last(outputs('Filas_de_la_pagina'))?['sequential'])",
                            "@variables('seq')"
                          ]
                        }
                      }
                    ]
                  },
                  "actions": {
                    "Modo_siguiente": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": {
                        "name": "modo",
                        "value": "1"
                      }
                    },
                    "Sequential_siguiente": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Modo_siguiente": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "seq",
                        "value": "@{string(last(outputs('Filas_de_la_pagina'))?['sequential'])}"
                      }
                    },
                    "UniqueSequential_siguiente": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Sequential_siguiente": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "useq",
                        "value": "@{string(coalesce(last(outputs('Filas_de_la_pagina'))?['uniqueSequential'], last(outputs('Filas_de_la_pagina'))?['sequential']))}"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Error_sin_avance": {
                        "type": "SetVariable",
                        "runAfter": {},
                        "inputs": {
                          "name": "error",
                          "value": "La paginación no avanza: el banco devolvió el mismo último sequential que en la página anterior"
                        }
                      },
                      "Fin_sin_avance": {
                        "type": "SetVariable",
                        "runAfter": {
                          "Error_sin_avance": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "name": "fin",
                          "value": true
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Fin_ultima_pagina": {
                    "type": "SetVariable",
                    "runAfter": {},
                    "inputs": {
                      "name": "fin",
                      "value": true
                    }
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Error_del_banco": {
                "type": "SetVariable",
                "runAfter": {},
                "inputs": {
                  "name": "error",
                  "value": "@{concat('getMovementsDetail respondió success=false: ', string(body('getMovementsDetail')?['message']))}"
                }
              },
              "Fin_por_error": {
                "type": "SetVariable",
                "runAfter": {
                  "Error_del_banco": [
                    "Succeeded"
                  ]
                },
                "inputs": {
                  "name": "fin",
                  "value": true
                }
              }
            }
          }
        }
      }
    },
    "Todos_los_movimientos": {
      "type": "Compose",
      "runAfter": {
        "Paginar_movimientos": [
          "Succeeded"
        ]
      },
      "inputs": "@json(concat('[', variables('acumulado'), ']'))"
    },
    "IDs_de_movimiento": {
      "type": "Select",
      "runAfter": {
        "Todos_los_movimientos": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@outputs('Todos_los_movimientos')",
        "select": "@string(coalesce(item()?['uniqueSequential'], item()?['sequential'], item()?['transactionId']))"
      }
    },
    "Verificacion": {
      "type": "Compose",
      "runAfter": {
        "Solo_debitos": [
          "Succeeded"
        ]
      },
      "inputs": {
        "Resultado": "@if(and(empty(variables('error')), equals(length(body('IDs_de_movimiento')), length(union(body('IDs_de_movimiento'), body('IDs_de_movimiento'))))), 'OK: paginación completa y sin repetidos', 'REVISAR')",
        "Paginas": "@variables('pagina')",
        "Movimientos": "@length(outputs('Todos_los_movimientos'))",
        "Unicos": "@length(union(body('IDs_de_movimiento'), body('IDs_de_movimiento')))",
        "Repetidos": "@sub(length(body('IDs_de_movimiento')), length(union(body('IDs_de_movimiento'), body('IDs_de_movimiento'))))",
        "Error": "@variables('error')",
        "Trae_transactionId": "@not(equals(first(outputs('Todos_los_movimientos'))?['transactionId'], null))",
        "Trae_sequential": "@not(equals(first(outputs('Todos_los_movimientos'))?['sequential'], null))",
        "Trae_uniqueSequential": "@not(equals(first(outputs('Todos_los_movimientos'))?['uniqueSequential'], null))",
        "Debitos": "@length(body('Solo_debitos'))",
        "Nota": "Solo lectura: no se llamó a ninguna API de transferencia."
      }
    },
    "Tabla_de_paginas": {
      "type": "Table",
      "runAfter": {
        "Verificacion": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@variables('paginas')",
        "format": "HTML"
      }
    },
    "Movimientos": {
      "type": "Select",
      "runAfter": {
        "Tabla_de_paginas": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@outputs('Todos_los_movimientos')",
        "select": {
          "ID": "@coalesce(item()?['uniqueSequential'], item()?['sequential'], item()?['transactionId'])",
          "Fecha": "@item()?['processDate']",
          "Hora": "@item()?['hour']",
          "DC": "@item()?['signDC']",
          "Importe": "@item()?['amount']",
          "Descripcion": "@item()?['description']",
          "Saldo": "@item()?['availableBalance']"
        }
      }
    },
    "Tabla_de_movimientos": {
      "type": "Table",
      "runAfter": {
        "Movimientos": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@body('Movimientos')",
        "format": "HTML"
      }
    },
    "Solo_debitos": {
      "type": "Query",
      "runAfter": {
        "IDs_de_movimiento": [
          "Succeeded"
        ]
      },
      "inputs": {
        "from": "@outputs('Todos_los_movimientos')",
        "where": "@equals(item()?['signDC'], 'D')"
      }
    }
  },
  "outputs": {}
}