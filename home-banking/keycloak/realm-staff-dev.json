{
  "realm": "staff",
  "enabled": true,
  "displayName": "VALO staff (Home Banking en Docker)",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "clients": [
    {
      "clientId": "home-banking-web",
      "name": "Home Banking VALO (SPA)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${HB_URL_PUBLICA:https://localhost}/*"
      ],
      "webOrigins": [
        "${HB_URL_PUBLICA:https://localhost}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${HB_URL_PUBLICA:https://localhost}/*"
      },
      "protocolMappers": [
        {
          "name": "audience-home-banking-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "home-banking-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "rootUrl": "${HB_URL_PUBLICA:https://localhost}"
    },
    {
      "clientId": "home-banking-api",
      "name": "Home Banking VALO (API)",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "home-banking-admin",
      "name": "Home Banking VALO (asignación de roles)",
      "publicClient": false,
      "secret": "${HB_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "roles": {
    "client": {
      "home-banking-api": [
        {
          "name": "operador"
        },
        {
          "name": "autorizante"
        },
        {
          "name": "auditor"
        },
        {
          "name": "administrador"
        },
        {
          "name": "transferencias:crear"
        },
        {
          "name": "transferencias:aprobar"
        }
      ]
    }
  },
  "users": [
    {
