{
  "title": "Home Banking - Seguridad y Resiliencia",
  "uid": "home-banking-resiliencia",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(homebanking_http_requests_total[1m]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errores 5xx / segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(homebanking_http_errors_5xx_total[1m]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia media (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(homebanking_http_request_duration_ms_sum[5m])) / clamp_min(sum(rate(homebanking_http_request_duration_ms_count[5m])), 1)" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests por ruta",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (route) (rate(homebanking_http_requests_total[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errores 5xx por ruta",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (route) (rate(homebanking_http_errors_5xx_total[5m]))", "legendFormat": "{{route}}" }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
