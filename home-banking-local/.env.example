# Configuración del Home Banking (instalación local). iniciar.sh / iniciar.ps1 lo copian a .env la primera vez.
# Después de cambiar algo, volver a correr iniciar.sh (no borra datos).

# ---- Acceso ----
# 127.0.0.1 = la aplicación solo se abre desde esta misma máquina (https://localhost).
# 0.0.0.0   = también desde otras PCs de la red interna (https://<nombre o IP de esta máquina>).
#             En ese caso NO abrir el puerto hacia internet en el router/firewall.
HB_ESCUCHA=127.0.0.1
HTTPS_PORT=443
# Nombre o IP con que entran las otras PCs (para el certificado autofirmado y los links de los correos).
# HB_NOMBRE_SERVIDOR=192.168.1.50
# HB_URL_PUBLICA=https://192.168.1.50

# ---- Usuarios (sin SSO: viven en la base y se administran en "Usuarios y permisos") ----
HB_ADMIN_USUARIO=admin          # primer administrador (solo si la base no tiene usuarios); su clave: secrets/admin_inicial_password.txt
HB_SESION_MINUTOS=15            # cada cuánto se renueva la sesión mientras se usa
HB_SESION_HORAS_MAX=10          # duración máxima de una sesión: después hay que volver a ingresar
HB_INTENTOS_MAX=5               # claves erróneas seguidas antes de bloquear el usuario...
HB_BLOQUEO_MINUTOS=15           # ...por estos minutos (o hasta que el administrador lo desbloquee)

# ---- Banco de Valores ----
# Ambiente de la credencial API Banking (en modo simulador se fuerza homo): homo | prod
BDV_AMBIENTE=homo
# true: saldos, movimientos, débitos y CBU reales, pero ninguna aprobación envía transferencias al banco.
BDV_SOLO_CONSULTAS=false
BDV_SESION_MINUTOS=20
BDV_CIRCUIT_BREAKER_ENABLED=true
BDV_CIRCUIT_BREAKER_FAILURES=5
BDV_CIRCUIT_BREAKER_RESET_MS=30000
# Clave de la credencial del simulador (solo modo sin internet)
# SIM_CLAVE=clave-simulador

# Meses completos que quedan en la base operativa además del mes en curso (lo anterior pasa a la histórica el día 1)
HB_RETENCION_MESES=1

# ---- Correo ----
# Vacío = buzón local (http://localhost:8025): nada sale de la máquina. Con el servidor de correo interno de VALO,
# completar estos datos; la clave va en secrets/smtp_password.txt.
# HB_SMTP_HOST=relay.valo.ar
# HB_SMTP_PORT=587
# HB_SMTP_FROM=alyc@valo.ar
# HB_SMTP_USUARIO=homebanking@valo.ar
# HB_SMTP_STARTTLS=true
# Alertas por Teams (Power Automate, sale a internet). Vacío = no se envían.
# HB_POWERAUTOMATE_URL=

# ---- SQL Server 2025 ----
ACCEPT_EULA=Y                   # términos de uso de Microsoft SQL Server (obligatorio)
MSSQL_PID=Developer             # Developer (pruebas, sin costo, no apta para producción), Standard, Enterprise o la clave de VALO
MSSQL_MEMORY_LIMIT_MB=3072      # SQL Server pide al menos 2 GB
DB_TRUST_SERVER_CERT=true

# ---- Observabilidad (opcional, apagada) ----
METRICS_ENABLED=false
SYNTHETIC_MONITOR_ENABLED=false
OTEL_ENABLED=false
