{
  "name": "dani-valo",
  "private": true,
  "description": "Herramientas de verificación de VALO (tests y chequeo de tipos). La aplicación no usa dependencias de npm.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:estado": "node valo/bastanteo/generar-estado.mjs",
    "test:bastanteo": "node --test valo/tests/bastanteo.test.js valo/tests/bastanteo-estado.test.mjs valo/tests/bastanteo-razonamiento.test.mjs valo/tests/inventarios.test.js",
    "test:so": "node --test so/tests/intent.test.mjs so/tests/vista.test.mjs so/tests/avatar.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
